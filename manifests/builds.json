{
  "workflow": {
    "manual": {
      "default_repo": "lede",
      "default_device": "all",
      "default_flavor": "standard"
    }
  },
  "builds": {
    "lede": {
      "branch": "master",
      "url": "https://github.com/coolsnowwolf/lede",
      "devices": [
        {
          "id": "x86_64",
          "op_name": "x86_64",
          "flavor": "standard",
          "target_config": "configs/targets/x86_64.config",
          "app_config": "configs/apps/lede/standard.config",
          "driver_config": "configs/drivers/lede/common.config",
          "cache_scope": "lede-x86_64-standard"
        },
        {
          "id": "x86_64",
          "op_name": "x86_64",
          "flavor": "lite",
          "target_config": "configs/targets/x86_64.config",
          "app_config": "configs/apps/common/lite.config",
          "cache_scope": "lede-x86_64-lite",
          "driver_config": "configs/drivers/lede/common.config"
        },
        {
          "id": "rpi3",
          "op_name": "Raspberry Pi3B+",
          "flavor": "standard",
          "target_config": "configs/targets/rpi3.config",
          "app_config": "configs/apps/lede/standard.config",
          "driver_config": "configs/drivers/lede/common.config",
          "cache_scope": "lede-rpi3-standard"
        },
        {
          "id": "rpi3",
          "op_name": "Raspberry Pi3B+",
          "flavor": "lite",
          "target_config": "configs/targets/rpi3.config",
          "app_config": "configs/apps/common/lite.config",
          "cache_scope": "lede-rpi3-lite",
          "driver_config": "configs/drivers/lede/common.config"
        },
        {
          "id": "rpi4",
          "op_name": "Raspberry Pi4",
          "flavor": "standard",
          "target_config": "configs/targets/rpi4.config",
          "app_config": "configs/apps/lede/standard.config",
          "driver_config": "configs/drivers/lede/common.config",
          "cache_scope": "lede-rpi4-standard"
        },
        {
          "id": "rpi4",
          "op_name": "Raspberry Pi4",
          "flavor": "lite",
          "target_config": "configs/targets/rpi4.config",
          "app_config": "configs/apps/common/lite.config",
          "cache_scope": "lede-rpi4-lite",
          "driver_config": "configs/drivers/lede/common.config"
        },
        {
          "id": "rpi5",
          "op_name": "Raspberry Pi5",
          "flavor": "standard",
          "target_config": "configs/targets/rpi5.config",
          "app_config": "configs/apps/lede/standard.config",
          "driver_config": "configs/drivers/lede/common.config",
          "cache_scope": "lede-rpi5-standard"
        },
        {
          "id": "rpi5",
          "op_name": "Raspberry Pi5",
          "flavor": "lite",
          "target_config": "configs/targets/rpi5.config",
          "app_config": "configs/apps/common/lite.config",
          "cache_scope": "lede-rpi5-lite",
          "driver_config": "configs/drivers/lede/common.config"
        },
        {
          "id": "rockchip",
          "op_name": "R68S-R2S-R4S-R5C-R5S-OPiR1Plus",
          "flavor": "standard",
          "target_config": "configs/targets/rockchip.config",
          "app_config": "configs/apps/lede/standard.config",
          "driver_config": "configs/drivers/lede/common.config",
          "cache_scope": "lede-rockchip-standard"
        },
        {
          "id": "rockchip",
          "op_name": "R68S-R2S-R4S-R5C-R5S-OPiR1Plus",
          "flavor": "lite",
          "target_config": "configs/targets/rockchip.config",
          "app_config": "configs/apps/common/lite.config",
          "cache_scope": "lede-rockchip-lite",
          "driver_config": "configs/drivers/lede/common.config"
        }
      ]
    },
    "immortalwrt": {
      "branch": "master",
      "url": "https://github.com/immortalwrt/immortalwrt",
      "devices": [
        {
          "id": "x86_64",
          "op_name": "x86_64",
          "flavor": "lite",
          "target_config": "configs/targets/x86_64.config",
          "app_config": "configs/apps/common/lite.config",
          "driver_config": "configs/drivers/immortalwrt/common.config",
          "cache_scope": "immortalwrt-x86_64-lite"
        },
        {
          "id": "rockchip",
          "op_name": "R68S-R2S-R4S-R5C-R5S-OPiR1Plus",
          "flavor": "lite",
          "target_config": "configs/targets/rockchip.config",
          "app_config": "configs/apps/common/lite.config",
          "driver_config": "configs/drivers/immortalwrt/common.config",
          "cache_scope": "immortalwrt-rockchip-lite"
        },
        {
          "id": "rpi3",
          "op_name": "Raspberry Pi3B+",
          "flavor": "lite",
          "target_config": "configs/targets/rpi3.config",
          "app_config": "configs/apps/common/lite.config",
          "driver_config": "configs/drivers/immortalwrt/common.config",
          "cache_scope": "immortalwrt-rpi3-lite"
        },
        {
          "id": "rpi4",
          "op_name": "Raspberry Pi4",
          "flavor": "lite",
          "target_config": "configs/targets/rpi4.config",
          "app_config": "configs/apps/common/lite.config",
          "driver_config": "configs/drivers/immortalwrt/common.config",
          "cache_scope": "immortalwrt-rpi4-lite"
        },
        {
          "id": "rpi5",
          "op_name": "Raspberry Pi5",
          "flavor": "lite",
          "target_config": "configs/targets/rpi5.config",
          "app_config": "configs/apps/common/lite.config",
          "driver_config": "configs/drivers/immortalwrt/common.config",
          "cache_scope": "immortalwrt-rpi5-lite"
        }
      ]
    }
  }
}
